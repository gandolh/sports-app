# sports-app: local environment. Copy to `.env` at the repo root.
#
# `npm run server` and `npm run dev` both load it (Node's --env-file-if-exists),
# and a variable already set in the shell wins over the file. The deploy does not
# read it; vps-deploy passes its own values.

# --- Ward (sign-in) -----------------------------------------------------------
# Required by the state service (server/state-server.mjs), which refuses to start
# without all three. Locally they point at Ward's container in
# ../wzd_auth/infrastructure/local; its seed.mjs writes a working WARD_APP_KEY
# into your .env. The key is a secret: never commit a real one.
WARD_PUBLIC_ORIGIN=http://localhost:8792
WARD_API_BASE_PATH=/ward-api
WARD_APP_KEY=wak_replace_me

# --- Client dev server ----------------------------------------------------------
# Serve the app under the deploy's path, so Ward's redirect back lands inside it.
# Open http://localhost:5173/sports-app/ and leave Settings → Service address empty.
SPORTS_APP_BASE=/sports-app/
