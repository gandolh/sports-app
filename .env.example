# sports-app: local environment. Copy to `.env` at the repo root.
#
# `npm run server` and `npm run dev` both load it (Node's --env-file-if-exists),
# and a variable already set in the shell wins over the file. The deploy does not
# read it; vps-deploy passes its own values.

# --- Accounts (sign-in) -------------------------------------------------------
# The state service has its own accounts. Create one with `npm run seed`, which
# asks for a username and a password (or reads SPORTS_APP_SEED_USERNAME and
# SPORTS_APP_SEED_PASSWORD from the shell; never put them in this file).
#
# What the BROWSER puts in front of `/api`. Empty in development (the dev server
# proxies `/api`); the deploy's reverse proxy strips a prefix, and the session
# cookie's Path and Ward's redirect URI both follow this value, so set it once for
# the service and for the client build. Leading slash, no trailing one.
SPORTS_APP_API_PREFIX=
# The address the browser uses for the app, without a path. Optional when the Ward
# redirect URI below is set (it is derived from it); needed to mark cookies Secure.
# SPORTS_APP_PUBLIC_ORIGIN=http://localhost:5173

# --- Sign in with Ward (optional) ---------------------------------------------
# With no WARD_OIDC_ISSUER the service runs with local accounts only and the
# sign-in page has no Ward button. Locally they point at Ward's container in
# ../wzd_auth/infrastructure/local; its seed.mjs registers this app as a client
# and writes all five into your .env. The key is a secret: never commit a real one.
#
# The redirect URI is the library's callback under the API prefix as the browser
# sees it: <prefix>/api/auth/ward/callback. It has to match what Ward has
# registered exactly, and it has to change together with SPORTS_APP_API_PREFIX.
WARD_OIDC_ISSUER=http://localhost:8792/ward-api/oidc
WARD_OIDC_CLIENT_ID=sports-app
WARD_OIDC_CLIENT_KEY=
WARD_OIDC_REDIRECT_URI=http://localhost:5173/api/auth/ward/callback
WARD_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/sports-app/

# --- Client dev server ----------------------------------------------------------
# Serve the app under the deploy's path, so Ward's redirect back lands inside it.
# Open http://localhost:5173/sports-app/.
SPORTS_APP_BASE=/sports-app/
