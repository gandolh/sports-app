{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals"]
  },
  /* `vite.config.ts` is included so the `test` block inside it is typechecked —
     that block is the reason `defineConfig` must come from `vitest/config` rather
     than from `vite`, and leaving the file out of the program is how that mistake
     goes unnoticed (TS2769). See the comment at the top of the file. */
  "include": ["src", "vite.config.ts"]
}
