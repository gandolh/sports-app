  "cards": [
    {
      "dot": "emerald",
      "title": "Offline-first is structural",
      "items": [
        "The client owns the state; the service is somewhere to put a copy",
        "With the service unreachable the app does not degrade, it just does not sync",
        "A change that makes a screen wait on the network breaks the product's promise"
      ]
    },
    {
      "dot": "cyan",
      "title": "Whole documents, not tables",
      "items": [
        "One JSON snapshot row per save, one stream per user",
        "Recovery is a single sqlite3 SELECT with no application code running",
        "Bytes are preserved exactly — which is why GET has no response schema"
      ]
    },
    {
      "dot": "amber",
      "title": "What Ward closed",
      "items": [
        "One shared secret used to authenticate the INSTALLATION, not a person",
        "Anyone holding it could read any history by editing ?user=",
        "The session's subject is now the key, so the target is not caller-chosen"
      ]
    }
  ]
