{
  "name": "sports-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-equipment calisthenics trainer. Offline-first PWA plus a state service.",
  "workspaces": [
    "shared",
    "client",
    "server",
    "docs"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev --workspace @sports-app/client",
    "build": "npm run build --workspace @sports-app/client",
    "build:server": "npm run build --workspace @sports-app/server",
    "preview": "npm run preview --workspace @sports-app/client",
    "server": "npm run dev --workspace @sports-app/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:conventions && npm test",
    "seed": "npm run seed --workspace @sports-app/server",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:fast": "npm run typecheck && node scripts/check-fast.mjs",
    "check:conventions": "knip && depcruise client/src server shared && node vendor/house-style/bin/check-base-ui.mjs && node vendor/house-style/bin/check-structure.mjs --warn-only"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "serialize-javascript": "^7.0.5",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "postcss-selector-parser": "^7.1.6"
  }
}
