{
  "name": "@sports-app/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The state service. Fastify, node:sqlite, and the shared contract.",
  "exports": {
    "./db.ts": "./src/db.ts",
    "./state-server.ts": "./src/state-server.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../.env src/state-server.ts",
    "start": "node --env-file-if-exists=../.env dist/state-server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=../.env src/seed-users.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "@sports-app/shared": "0.1.0",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
